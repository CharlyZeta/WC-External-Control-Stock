# ============================================
# StockDual - Variables de Entorno
# ============================================
# Copiar este archivo a .env y modificar los valores
# NO commitear el archivo .env con credenciales reales

# ============================================
# Base de Datos
# ============================================
DB_URL=jdbc:postgresql://localhost:5433/stockdual
DB_USER=stockdual
DB_PASSWORD=cambiar_esta_password_por_una_segura

# Puerto de la base de datos (mapeo del host)
DB_PORT=5433

# Credenciales internas de PostgreSQL (docker-compose)
POSTGRES_DB=stockdual
POSTGRES_USER=stockdual
POSTGRES_PASSWORD=cambiar_esta_password_por_una_segura

# ============================================
# Servidor
# ============================================
SERVER_PORT=8080

# ============================================
# WooCommerce API (opcional)
# ============================================
# WC_API_URL=https://mi-tienda.com
# WC_CONSUMER_KEY=ck_tu_consumer_key_aqui
# WC_CONSUMER_SECRET=cs_tu_consumer_secret_aqui
