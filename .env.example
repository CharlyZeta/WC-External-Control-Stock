# Plantilla de variables de entorno para desarrollo local.
# Copiar a .env (.env está ignorado por git) o exportar las variables en la terminal.

# --- Docker Compose: contraseña del contenedor PostgreSQL ---
POSTGRES_PASSWORD=localdev

# --- Aplicación: variables de entorno reales (Spring NO lee este archivo) ---
DB_PASSWORD=localdev
STOCKDUAL_ENCRYPTION_KEY=clave-de-desarrollo-de-32-caracteres
STOCKDUAL_ADMIN_PASSWORD=cambiar-en-produccion
